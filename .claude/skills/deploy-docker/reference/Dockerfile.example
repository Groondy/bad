# Dockerfile multi-stage pour une app Nuxt (build Nitro) avec pnpm
# À adapter : version de Node si besoin

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# --- Stage dépendances ---
FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# --- Stage build ---
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

# --- Stage final (image légère, prod uniquement) ---
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# Port interne de l'app (Nitro écoute par défaut sur 3000, à adapter si besoin)
ENV PORT=3000
ENV HOST=0.0.0.0

COPY --from=build /app/.output ./.output

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
